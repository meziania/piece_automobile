PORT=3000

# Email qui reçoit chaque réponse en PDF
MAIL_TO=ton.email@gmail.com

# Expéditeur (souvent le même compte Gmail)
MAIL_FROM=ton.email@gmail.com

# Gmail : mot de passe d'application (pas le mot de passe du compte)
# Compte Google → Sécurité → Validation en 2 étapes → Mots de passe des applications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.email@gmail.com
SMTP_PASS=

# Page /admin pour télécharger tous les PDF
ADMIN_PASSWORD=change-moi
